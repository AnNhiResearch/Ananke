{
  "name": "@ananke/tui",
  "version": "0.1.0",
  "description": "Official TypeScript TUI client for Ananke agent runtime with differential rendering (AD-12)",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "ananke-tui": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "bun test",
    "check": "tsc --noEmit",
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts"
  },
  "keywords": ["ananke", "tui", "agent", "terminal", "differential-rendering"],
  "author": "AnNhi Research & AnNhi AI & contributors of Ananke",
  "license": "MIT",
  "dependencies": {
    "eventsource": "^2.0.2"
  },
  "devDependencies": {
    "@types/eventsource": "^1.1.15",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
